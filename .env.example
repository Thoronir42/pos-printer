# pos-printer runtime config. Copy to `.env` and fill in.
# On the Raspberry Pi this file lives next to the app (loaded via deno --env-file).

# Required: BotFather token for the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Required: chat id that receives janitor / status messages.
TELEGRAM_JANITOR_CHAT_ID=

# Optional: directory where printed images are archived. Enables the archive and
# the /disk janitor command. Must match the bot task's --allow-write path.
POS_HISTORY_PRINTS=./data/prints
