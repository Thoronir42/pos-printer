# pos-printer runtime configuration.
#
# On a Raspberry Pi, copy this file onto the boot partition as
#   /boot/firmware/pos-printer.env
# and fill in the values. First-boot provisioning copies it to
#   /opt/pos-printer/.env
#
# Locally, copy it to the repo root as `.env`.

# Telegram bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=

# Chat id of the janitor (required for the startup ping and /disk command).
# For a private chat this equals your Telegram user id. Find it by messaging
# the bot once and reading the chat.id from getUpdates, or via @userinfobot.
TELEGRAM_JANITOR_CHAT_ID=

# Where received/printed images are archived. On the Pi, keep the default.
POS_HISTORY_PRINTS=/opt/pos-printer/data/prints

# Optional header image printed above each job.
# POS_PRINTER_HEADER_IMG=/opt/pos-printer/data/.local/convention-title-header-sm.svg

# Optional: override the git repository the Pi provisions from (used only by
# first-boot provisioning). Defaults to the public HTTPS URL.
# POS_PRINTER_REPO=https://github.com/Thoronir42/pos-printer.git
